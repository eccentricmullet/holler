# Holler keys. Step 1 copies this to a file named .env.local in the project root.
# Paste each value after the = sign. Never share .env.local or commit it.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
